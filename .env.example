# Хуулж .env нэртэй хадгалаад утгуудаа бөглөнө үү. .env-ийг git-д бүү оруул.
PORT=3000
PUBLIC_URL=http://localhost:3000

# ---------- Үнэгүй AI (дор хаяж нэгийг тохируулбал хариу AI-аар бичигдэнэ) ----------
# Дараалал: эхнийх нь ажиллахгүй бол дараагийнх руу шилжинэ. Бүгд бүтэлгүйтвэл загвараар гаргана.
AI_PROVIDERS=gemini,groq,openrouter,ollama

# Google Gemini — монгол хэлэнд хамгийн сайн. Түлхүүр: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest

# Groq — маш хурдан. Түлхүүр: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — ":free" төгсгөлтэй загварууд үнэгүй. Түлхүүр: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama — өөрийн компьютер дээр бүрэн үнэгүй, хязгааргүй (https://ollama.com)
# OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Нэг IP-ээс цагт үүсгэх төлөвлөгөөний дээд тоо (AI-ийн үнэгүй квотыг хамгаална)
PLAN_LIMIT_PER_HOUR=20
# Бүх AI үйлчилгээг оролдох нийт хугацаа (мс)
AI_TIMEOUT_MS=90000

# ---------- QPay ----------
PLAN_PRICE=6900
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Зөвхөн өөрийн компьютер дээр true болго: QPay тохируулаагүй үед төлбөргүйгээр нээнэ.
# QPay-ийн мэдээлэл оруулсан үед энэ тохиргоо үйлчлэхгүй.
QPAY_TEST_MODE=false

# ---------- Сервер ----------
# nginx, Cloudflare зэрэг reverse proxy-ийн ард ажиллуулж байгаа бол true
TRUST_PROXY=false
# /admin.html статистикийн хуудасны нууц үг (урт, санамсаргүй утга)
ADMIN_TOKEN=
